{
  "expo": {
    "name": "Hang",
    "slug": "hang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hang",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDF0EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.prathamesh.hang",
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withShareActivity.js",
      "./plugins/withConfigChanges.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#EDF0EA",
          "dark": {
            "backgroundColor": "#161C18"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Newsreader-Text-Regular.ttf",
            "./assets/fonts/Newsreader-Text-Italic.ttf",
            "./assets/fonts/Newsreader-Display-Book.ttf",
            "./assets/fonts/Newsreader-Display-Regular.ttf",
            "./assets/fonts/Newsreader-Display-Italic-Book.ttf",
            "./assets/fonts/Newsreader-Display-Italic.ttf",
            "./assets/fonts/HankenGrotesk-Medium.ttf",
            "./assets/fonts/HankenGrotesk-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
